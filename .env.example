# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=https://vietradar.com

# Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Postgres
POSTGRES_DB=nhatrang_map
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nhatrang_map

# Admin auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_salt:replace_with_scrypt_hash
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=false

# Feedback email
FEEDBACK_TO_EMAIL=steveji1@gmail.com
EMAIL_FROM=
EMAIL_FROM_NAME=VietRadar Feedback

# UniSender Go HTTP API (используется в проде — VPS блокирует исходящий SMTP)
# 1) Регистрация:        https://go.unisender.ru/
# 2) Подтвердить домен:  https://go1.unisender.ru/ru/domain  (DKIM/SPF записи в DNS)
# 3) Получить ключ API:  https://go1.unisender.ru/ru/settings/security/api
# UNISENDER_GO_HOST по умолчанию go1.unisender.ru; если в кабинете URL начинается
# с go2.unisender.ru — поменяйте на go2.unisender.ru
UNISENDER_GO_API_KEY=
UNISENDER_GO_HOST=go1.unisender.ru

# SMTP (используется только если UNISENDER_GO_API_KEY не задан — например, локально)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Seed behavior
SEED_DEMO_DATA=false

# Generate ADMIN_PASSWORD_HASH:
# node -e "const { randomBytes, scryptSync } = require('crypto'); const salt = randomBytes(16).toString('hex'); const hash = scryptSync('your-password', salt, 64).toString('hex'); console.log(salt + ':' + hash)"
