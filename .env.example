# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=https://vietradar.com

# Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Postgres
POSTGRES_DB=nhatrang_map
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nhatrang_map

# Admin auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_salt:replace_with_scrypt_hash
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=false

# Feedback email
FEEDBACK_TO_EMAIL=steveji1@gmail.com
EMAIL_FROM=
EMAIL_FROM_NAME=VietRadar Feedback

# Brevo HTTP API (используется в проде — VPS блокирует исходящий SMTP)
# Получить ключ: https://app.brevo.com/settings/keys/api → Create a new API key
BREVO_API_KEY=

# SMTP (используется только если BREVO_API_KEY не задан — например, локально)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Seed behavior
SEED_DEMO_DATA=false

# Generate ADMIN_PASSWORD_HASH:
# node -e "const { randomBytes, scryptSync } = require('crypto'); const salt = randomBytes(16).toString('hex'); const hash = scryptSync('your-password', salt, 64).toString('hex'); console.log(salt + ':' + hash)"
