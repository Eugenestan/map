# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local deployment helpers with machine-specific credentials
/deploy/deploy_remote.py
/deploy/update_remote.py

# vercel
.vercel

# local database
/data/*.db
/data/*.db-wal
/data/*.db-shm

# typescript
*.tsbuildinfo
next-env.d.ts

# старая копия проекта (не путать с деплоем)
/map
